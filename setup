#!/usr/bin/bash -e 
set -e

### Write environment variables from docker-compose.yml to .env
### Only modify the .env file if it exists.
if [[ -e /var/www/html/.env ]]; then
  MY_VARS=(
           "APP_URL"
           "SESSION_SECURE_COOKIE"
           "APP_PROXY"
           "APP_CUSTOM_MAIL_HEADERS"
           "APP_UPDATE_FOLDER_COUNTERS_IN_BACKGROUND"
           "APP_TIMEZONE"
           "APP_TRUSTED_PROXIES"
           "APP_REMOTE_HOST_WHITE_LIST"
           "DB_CONNECTION"
           "DB_HOST"
           "DB_PORT"
           "DB_DATABASE"
           "DB_USERNAME"
           "DB_PASSWORD"
           "APP_KEY"
           "APP_DEBUG"
  )
  for I in "${MY_VARS[@]}"; do
    if [[ -v $I ]]; then
      sed -i "/^$I/d" /var/www/html/.env
      echo $I=${!I} >> /var/www/html/.env
    fi
  done
  php artisan freescout:clear-cache
  find /var/www/html -user root -exec chown www-data:www-data {} +
fi


### Run FreeScout setup. Run only once
if [[ ! -f /var/www/html/storage/.installed ]]; then
  php artisan key:generate
  php artisan freescout:clear-cache
  php artisan storage:link
  php artisan migrate:fresh --force
  php artisan freescout:create-user \
              --role=admin \
              --firstName=Admin \
              --lastName=Admin \
              --email=admin@example.com \
              --password=admin_passwd \
              --no-interaction
  touch storage/.installed
  find /var/www/html -user root -exec chown www-data:www-data {} +
fi


### Running default php-apache entrypoint script
exec docker-php-entrypoint "$@"
